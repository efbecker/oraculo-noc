"""
MODELO de configuracao do Oraculo NOC.

Este arquivo (config.py.example) E versionado no git. O arquivo REAL usado pela
aplicacao e o config.py, que fica FORA do git (.gitignore) por conter valores
proprios de cada ambiente. O install.sh gera o config.py a partir deste modelo
na primeira execucao.

O que continua aqui (e por que NAO migrou para o painel):
  - SECRET_KEY / DB_PATH / AUDIO_DIR ........ infra da aplicacao, lida no boot
  - OCI_ENDPOINT / OCI_COMPARTMENT_ID ....... endpoint/compartment do OCI GenAI
  - ZABBIX_URL .............................. URL padrao do Zabbix (fallback)

O que NAO esta mais aqui (migrou para Admin -> Inteligencia Artificial):
  - a CHAVE de API da IA e a escolha de provedor/modelo. So a chave de IA saiu;
    o restante acima ainda e lido de config.py na inicializacao.
"""
import os
import tempfile

# ================= CONFIGURACOES GERAIS =================
# SECRET_KEY assina as sessoes de login. NUNCA use o valor de exemplo em
# producao: gere uma aleatoria com  python3 -c "import secrets; print(secrets.token_hex(32))"
# O install.sh ja gera uma automaticamente ao criar o config.py.
SECRET_KEY = os.getenv("SECRET_KEY", "TROQUE-por-uma-chave-aleatoria-longa")

# Caminho do banco SQLite (usado so quando o motor e SQLite; se voce configurar
# PostgreSQL no painel, este caminho e ignorado).
DB_PATH = '/opt/oraculo-noc/oraculo_zabbix.db'

# Pasta temporaria dos audios do TTS (recriada automaticamente).
AUDIO_DIR = os.path.join(tempfile.gettempdir(), 'oraculo_audio')
os.makedirs(AUDIO_DIR, exist_ok=True)

# ================= CONFIGURACOES DA OCI =================
# So relevante se o provedor de IA (no painel) for OCI/Cohere. Fora da OCI,
# a autenticacao usa ~/.oci/config (API Key) - ver MIGRACAO.md, Etapa 3.
OCI_ENDPOINT = "https://inference.generativeai.sa-saopaulo-1.oci.oraclecloud.com"
OCI_COMPARTMENT_ID = "ocid1.tenancy.oc1..COLOQUE_SEU_COMPARTMENT_OCID_AQUI"

# ================= CONFIGURACOES DO ZABBIX =================
# URL padrao da API do Zabbix. Cada usuario pode ter uma URL propria no painel;
# esta e o fallback global quando o usuario nao define a dele.
ZABBIX_URL = "https://monitoramento.SEU-DOMINIO.cloud/api_jsonrpc.php"
