# Renomeie este arquivo para .env em /opt/oraculo-noc/ e ajuste os valores.
# Usado pelo systemd (EnvironmentFile). NÃO use aspas nos valores.
# OBS: se você salvar a config pelo painel Admin > Banco de Dados, o arquivo
# instance/db_config.json tem PRIORIDADE sobre estas variáveis.
DB_ENGINE=postgres
PG_HOST=10.0.0.230
PG_PORT=5432
PG_DB=oraculo
PG_USER=oraculo
PG_PASSWORD=troque-esta-senha
