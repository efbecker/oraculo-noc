# Ignorar arquivos do Python e ambientes virtuais
__pycache__/
*.pyc
venv/
env/

# Ignorar banco de dados e mídias geradas
*.db
sqlite3.db
app/static/*.html
app/static/*.png
app/static/*.mp3

# Ignorar arquivos de configuração com senhas reais!
config.py
!config.py.example

# Ignorar configs e backups gerados em runtime (senha do Postgres, dumps do banco)
instance/
